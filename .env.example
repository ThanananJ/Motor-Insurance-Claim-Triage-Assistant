# MVP advisory Local LLM provider.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_NUM_CTX=32768
OLLAMA_RESERVED_OUTPUT_TOKENS=256
PROMPT_TOKEN_WARNING_PERCENT=70
PROMPT_TOKEN_CRITICAL_PERCENT=85

# Install this tested advisory model locally, or replace it with another
# explicitly evaluated local model. Human Confirmation remains mandatory.
OLLAMA_MODEL=qwen2.5:3b
